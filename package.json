{
  "name": "engineering-harness-axi",
  "version": "0.2.0",
  "private": true,
  "description": "An extensible repository harness with AXI-style commands and architecture sensors.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "harness": "node harness.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:app": "node --import tsx --test tests/application/*.test.ts",
    "test:dotnet": "node --import tsx --test tests/dotnet/*.test.ts",
    "lint": "eslint src --max-warnings 0",
    "build": "tsc --project tsconfig.build.json",
    "skill:generate": "node --import tsx scripts/generate-skill.ts",
    "skill:check": "node --import tsx scripts/generate-skill.ts --check",
    "check": "npm run typecheck && npm test && npm run skill:check && node harness.mjs verify"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0",
    "commander": "15.0.0",
    "eslint": "10.12.0",
    "fast-xml-parser": "5.11.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
